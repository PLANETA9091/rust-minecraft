        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    }
  ]
