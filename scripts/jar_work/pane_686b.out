        "model": "minecraft:block/iron_bars_post"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_cap"
      },
      "when": {
        "east": "false",
        "north": "true",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_cap",
        "y": 90
      },
      "when": {
        "east": "true",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_cap_alt"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_cap_alt",
        "y": 90
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "minecraft:block/iron_bars_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
